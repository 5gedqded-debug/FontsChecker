<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FontsChecker">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Открытие шрифта из других приложений (файловые менеджеры и т.п.) -->
        <activity
            android:name=".PreviewActivity"
            android:exported="true"
            android:parentActivityName=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="font/*" />
                <data android:mimeType="application/x-font-ttf" />
                <data android:mimeType="application/x-font-otf" />
                <data android:mimeType="application/x-font-opentype" />
                <data android:mimeType="application/x-font-truetype" />
                <data android:mimeType="application/font-sfnt" />
                <data android:mimeType="application/vnd.ms-opentype" />
                <data android:mimeType="application/font-woff" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-7z-compressed" />
            </intent-filter>
        </activity>
    </application>

</manifest>
